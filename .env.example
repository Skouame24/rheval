# ⚠️ Modèle uniquement : ne jamais mettre de vraie valeur dans ce fichier (il est versionné).
# Copier en .env.local (développement) ou .env.production.local (serveur).

# --- SSO Microsoft Entra ID ---
AZURE_AD_CLIENT_ID="..."
AZURE_AD_CLIENT_SECRET="..."
AZURE_AD_TENANT_ID="..."
NEXTAUTH_URL="https://portal.agillycloud.net"
NEXTAUTH_SECRET="a-generer"

# --- API backend ---
BACKEND_INTERNAL_URL="http://10.5.6.8:3001"
# Secret partagé avec l'API : EXACTEMENT la même valeur que AGILLY_API_SECRET du backend.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AGILLY_API_SECRET="a-generer"
